# Server Port
PORT=5000
NODE_ENV=development

# Priority 1: Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Priority 2: Groq Cloud API Key (Get free key from https://console.groq.com/)
GROQ_API_KEY=

# Cooldown duration in milliseconds when Gemini hits rate limit (default: 30 seconds)
GEMINI_COOLDOWN_MS=30000

# Maximum incoming image payload size in megabytes
MAX_IMAGE_SIZE_MB=10
